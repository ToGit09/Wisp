<Project Sdk="Microsoft.NET.Sdk">

  <!-- The local language model of the AI edition. Only referenced when building with -p:WispEdition=AI,
       so the light edition contains no AI code or native libraries at all. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wisp.Ai</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wisp.Core\Wisp.Core.csproj" />
  </ItemGroup>

</Project>
