<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wisp.App.ViewModels"
        xmlns:v="using:Wisp.App.Views"
        xmlns:t="using:Wisp.App.Theme"
        x:Class="Wisp.App.Views.ComposeWindow"
        x:DataType="vm:ComposeViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/wisp.ico"
        Width="720" Height="620" MinWidth="480" MinHeight="380">


  <DockPanel Margin="20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="70,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
      <Grid.Styles>
        <Style Selector="TextBlock.label">
          <Setter Property="Foreground" Value="{DynamicResource WispMuted}" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox, ComboBox">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </Grid.Styles>

      <TextBlock Grid.Row="0" Classes="label" Text="Von" IsVisible="{Binding HasMultipleAccounts}" Margin="0,0,0,8" />
      <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding From}"
                HorizontalAlignment="Stretch" IsVisible="{Binding HasMultipleAccounts}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AccountChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Row="1" Classes="label" Text="An" Margin="0,0,0,8" />
      <DockPanel Grid.Row="1" Grid.Column="1">
        <Button DockPanel.Dock="Right" Classes="link" Content="Cc/Bcc" Margin="10,0,0,8" Command="{Binding ToggleCcCommand}" />
        <TextBox Text="{Binding To}" PlaceholderText="name@beispiel.de, …" />
      </DockPanel>

      <TextBlock Grid.Row="2" Classes="label" Text="Cc" IsVisible="{Binding ShowCc}" Margin="0,0,0,8" />
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Cc}" IsVisible="{Binding ShowCc}" />
      <TextBlock Grid.Row="3" Classes="label" Text="Bcc" IsVisible="{Binding ShowCc}" Margin="0,0,0,8" />
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Bcc}" IsVisible="{Binding ShowCc}" />

      <TextBlock Grid.Row="4" Classes="label" Text="Betreff" Margin="0,0,0,8" />
      <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Subject}" />
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource WispDanger}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static v:Converters.NotNull}}" />
      <TextBlock Classes="hint" Text="Die Anhänge der ursprünglichen Mail werden mitgesendet." IsVisible="{Binding IsForwardingAttachments}" />
      <ItemsControl ItemsSource="{Binding AttachmentPaths}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Button Classes="chip" Margin="0,0,6,6" ToolTip.Tip="Entfernen"
                    Command="{Binding $parent[Window].((vm:ComposeViewModel)DataContext).RemoveAttachmentCommand}" CommandParameter="{Binding}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <t:WispIcon Data="{StaticResource IconAttach}" Width="13" Height="13" />
                <TextBlock Text="{Binding Converter={x:Static v:ComposeWindow.FileName}}" />
                <TextBlock Text="×" Classes="muted" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding SendCommand}" ToolTip.Tip="Senden (Strg+Enter)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <t:WispIcon Data="{StaticResource IconSent}" />
            <TextBlock Text="Senden" />
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="AttachButton" Classes="icon" ToolTip.Tip="Datei anhängen">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <t:WispIcon Data="{StaticResource IconAttach}" />
              <TextBlock Text="Anhängen" />
            </StackPanel>
          </Button>
          <Button x:Name="DiscardButton" Classes="icon" ToolTip.Tip="Verwerfen">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <t:WispIcon Data="{StaticResource IconTrash}" />
              <TextBlock Text="Verwerfen" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <!-- Editor mode + formatting tools -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsAdvanced}" OffContent="Light" OnContent="Advanced"
                    ToolTip.Tip="Light: einfacher Text. Advanced: HTML mit Formatierung und Vorschau. Beim Wechsel zurück zu Light wird die Formatierung entfernt." />
      <StackPanel x:Name="FormatBar" Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsAdvanced}" VerticalAlignment="Center">
        <StackPanel.Styles>
          <Style Selector="Button.icon">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="8,4" />
          </Style>
        </StackPanel.Styles>
        <Button Classes="icon" Tag="bold" ToolTip.Tip="Fett (Strg+B)"><TextBlock Text="B" FontWeight="Bold" /></Button>
        <Button Classes="icon" Tag="italic" ToolTip.Tip="Kursiv (Strg+I)"><TextBlock Text="I" FontStyle="Italic" /></Button>
        <Button Classes="icon" Tag="underline" ToolTip.Tip="Unterstrichen (Strg+U)"><TextBlock Text="U" TextDecorations="Underline" /></Button>
        <Button Classes="icon" Tag="color" ToolTip.Tip="Textfarbe">
          <StackPanel Spacing="1">
            <TextBlock Text="A" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Border Height="3" Width="14" CornerRadius="1" Background="#D64545" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <WrapPanel x:Name="ColorPanel" MaxWidth="180" />
            </Flyout>
          </Button.Flyout>
        </Button>
        <Rectangle Width="1" Height="18" Margin="6,0" Fill="{DynamicResource WispBorder}" />
        <Button Classes="icon" Tag="heading" ToolTip.Tip="Überschrift"><TextBlock Text="Ü" FontWeight="Bold" FontSize="15" /></Button>
        <Button Classes="icon" Tag="list" ToolTip.Tip="Aufzählung"><TextBlock Text="•≡" /></Button>
        <Button Classes="icon" Tag="numbered" ToolTip.Tip="Nummerierte Liste"><TextBlock Text="1." /></Button>
        <Button Classes="icon" Tag="quote" ToolTip.Tip="Zitat"><TextBlock Text="❝" /></Button>
        <Button Classes="icon" Tag="link" ToolTip.Tip="Link einfügen (Strg+K)"><TextBlock Text="Link" /></Button>
        <Button Classes="icon" Tag="rule" ToolTip.Tip="Trennlinie"><TextBlock Text="―" /></Button>
      </StackPanel>
    </DockPanel>

    <Panel>
      <TextBox Text="{Binding Body}" AcceptsReturn="True" TextWrapping="Wrap" x:Name="BodyBox" IsVisible="{Binding !IsAdvanced}"
               VerticalContentAlignment="Top" PlaceholderText="Ihre Nachricht …" />

      <Grid ColumnDefinitions="*,6,*" IsVisible="{Binding IsAdvanced}">
        <TextBox x:Name="SourceBox" Text="{Binding HtmlSource}" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace"
                 PlaceholderText="Text schreiben, markieren und oben formatieren. Zeilenumbrüche bleiben erhalten." />
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
        <Border Grid.Column="2" Background="White" BorderBrush="{DynamicResource WispBorder}" BorderThickness="1" CornerRadius="6">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Vorschau" FontSize="11" Foreground="#6A6F7C" Margin="12,8,12,0" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ContentControl x:Name="PreviewHost" Margin="12,4,12,12" />
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Panel>
  </DockPanel>
</Window>
