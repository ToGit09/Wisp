<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wisp.App.ViewModels"
        xmlns:v="using:Wisp.App.Views"
        xmlns:t="using:Wisp.App.Theme"
        x:Class="Wisp.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/wisp.ico"
        MinWidth="760" MinHeight="480">

  <Window.Styles>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="{DynamicResource WispSmallFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource WispMuted}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Quick actions in the selected mail row -->
    <Style Selector="ListBox.messages > ListBoxItem Border.quick">
      <Setter Property="Width" Value="0" />
    </Style>
    <Style Selector="ListBox.messages > ListBoxItem:selected Border.quick">
      <Setter Property="Width" Value="130" />
    </Style>
    <Style Selector="ListBox.messages.two > ListBoxItem:selected Border.quick">
      <Setter Property="Width" Value="88" />
    </Style>
    <!-- Selection mode: the actions are in the bar above the list, not in every selected row. -->
    <Style Selector="ListBox.messages.selecting > ListBoxItem:selected Border.quick">
      <Setter Property="Width" Value="0" />
    </Style>
    <!-- The colour sits on an inner Border, so Fluent's hover/pressed backgrounds do not replace it. -->
    <Style Selector="Button.tile">
      <Setter Property="Width" Value="38" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.tile > Border">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.tile:pointerover > Border">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.tile:pressed > Border">
      <Setter Property="Opacity" Value="0.7" />
    </Style>

    <!-- Sidebar: narrow strip of icons, expands over the message list while the mouse is on it. -->
    <Style Selector="Border#Sidebar">
      <Setter Property="Width" Value="64" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Tooltips in the sidebar open to the right. Near the bottom of the screen they would otherwise
         flip upwards, land under the mouse, make the sidebar think the mouse left, collapse it, close
         again – an endless open/close loop (the "jitter" on the settings button). -->
    <Style Selector="Border#Sidebar :is(Control)">
      <Setter Property="ToolTip.Placement" Value="Right" />
      <Setter Property="ToolTip.HorizontalOffset" Value="12" />
    </Style>
    <Style Selector="Border#Sidebar:pointerover, Border#Sidebar.open">
      <Setter Property="Width" Value="240" />
    </Style>
    <Style Selector="Border#Sidebar:pointerover:not(.open)">
      <Setter Property="BoxShadow" Value="6 0 24 0 #26000000" />
    </Style>
    <!-- Only opacity changes between the two states, never size or visibility:
         the layout stays identical, so nothing jumps (that was the flicker). -->
    <Style Selector="Border#Sidebar :is(Control).wide">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border#Sidebar:pointerover :is(Control).wide, Border#Sidebar.open :is(Control).wide">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border#Sidebar:pointerover :is(Control).narrow, Border#Sidebar.open :is(Control).narrow">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- AIEdition: a summary as preview may take two lines -->
    <Style Selector="TextBlock.summary">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
    </Style>

    <!-- Quick reply: one calm line until clicked, then it makes room to write. -->
    <Style Selector="TextBox#QuickReplyBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="MinHeight" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBox#QuickReplyBox:focus-within">
      <Setter Property="MinHeight" Value="84" />
    </Style>

    <!-- Reader header: the sender's initials, larger than in the list -->
    <Style Selector="Border.avatar">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="19" />
    </Style>
  </Window.Styles>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding ComposeCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding ReplyCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding ReplyAllCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding ForwardCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="Ctrl+U" Command="{Binding ToggleReadCommand}" />
  </Window.KeyBindings>

  <Grid>
    <Grid x:Name="MainGrid" ColumnDefinitions="64,360,1,*">

      <!-- ─────────── Message list ─────────── -->
      <DockPanel Grid.Column="1" Background="{DynamicResource WispSurface}">
        <StackPanel DockPanel.Dock="Top" Margin="16,14,16,8" Spacing="10">
          <!-- Title with the unread count under it (like Apple Mail); the command field sits quietly on the right. -->
          <DockPanel>
            <!-- Says its own shortcut: one look teaches Strg+K. -->
            <Button DockPanel.Dock="Right" Classes="icon" Padding="6,5" VerticalAlignment="Top" Margin="8,2,-6,0"
                    Command="{Binding OpenPaletteCommand}" ToolTip.Tip="Ordner, Aktionen, Suche – alles in einem Feld">
              <Border Classes="kbd"><TextBlock Text="Strg K" /></Border>
            </Button>
            <StackPanel Spacing="0">
              <TextBlock Text="{Binding FolderTitle}" Classes="title" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding ListSubtitle}" Classes="muted small" Margin="0,1,0,0" />
            </StackPanel>
          </DockPanel>
          <TextBox x:Name="SearchBox" Classes="soft clearButton" Text="{Binding SearchText}" PlaceholderText="Suchen"
                   IsVisible="{Binding !IsOutboxSelected}" ToolTip.Tip="Suchen (Strg+F)">
            <TextBox.InnerLeftContent>
              <t:WispIcon Data="{StaticResource IconSearch}" Width="15" Height="15" Margin="10,0,0,0" VerticalAlignment="Center" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <!-- AIEdition, first start: the model downloads in the background – one slim line, not a text block. -->
          <StackPanel Spacing="5" IsVisible="{Binding IsAiDownloading}"
                      ToolTip.Tip="Das KI-Modell wird einmalig geladen. Wisp ist währenddessen normal nutzbar.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <t:WispIcon Data="{StaticResource IconSpark}" Width="12" Height="12" Classes="thinking" Foreground="{DynamicResource WispAccent}" />
              <TextBlock Text="{Binding AiProgressText}" Classes="muted small" />
            </StackPanel>
            <ProgressBar Classes="slim" Minimum="0" Maximum="1" Value="{Binding AiProgress}" />
          </StackPanel>
          <Border Classes="notice" IsVisible="{Binding AiNotice, Converter={x:Static v:Converters.NotNull}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="OK" Margin="12,0,0,0" Command="{Binding DismissAiNoticeCommand}" />
              <TextBlock Text="{Binding AiNotice}" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <!-- Wisp 2: inbox tabs (Einstellungen → Sortierung & KI) -->
          <!-- Segmented bar: soft rounded track, the chosen tab sits on a raised pill (TabPill) that glides to the
               next tab instead of jumping; the others show their symbol and unread count (name as tooltip), so all
               five fit the list column. Scrolls sideways (mouse wheel) if the column is made narrower still. -->
          <Border Classes="tabs" IsVisible="{Binding ShowCategoryTabs}" HorizontalAlignment="Left">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <Panel x:Name="TabTrack">
              <Border x:Name="TabPill" Classes="tabpill" Width="0" />
              <ItemsControl x:Name="TabItems" ItemsSource="{Binding CategoryTabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CategoryTab">
                    <Button Classes="tab" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Label}"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectCategoryCommand}" CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <t:WispIcon Data="{Binding Icon}" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" Classes="small" VerticalAlignment="Center" IsVisible="{Binding IsSelected}" />
                        <Border Classes="count" IsVisible="{Binding HasUnread}">
                          <TextBlock Text="{Binding UnreadText}" />
                        </Border>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </Panel>
            </ScrollViewer>
          </Border>
          <Border Classes="notice" IsVisible="{Binding FolderWarning, Converter={x:Static v:Converters.NotNull}}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding FolderWarning}" TextWrapping="Wrap" />
              <Button Classes="link" Content="Ja, diese Mails wurden wirklich gelöscht" Command="{Binding ApproveMassDeleteCommand}" />
            </StackPanel>
          </Border>
          <!-- Selection mode (double-click on a mail): clicks add or remove mails -->
          <Border Classes="notice" IsVisible="{Binding IsSelectionMode}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Fertig" Margin="14,0,0,0" FontWeight="SemiBold"
                      Command="{Binding EndSelectionCommand}" ToolTip.Tip="Auswahl beenden (Esc)" />
              <Button DockPanel.Dock="Right" Classes="link" Content="Löschen" Margin="14,0,0,0"
                      Command="{Binding DeleteCommand}" ToolTip.Tip="Ausgewählte Mails löschen (Entf)" />
              <Button DockPanel.Dock="Right" Classes="link" Content="Gelesen" Margin="14,0,0,0"
                      Command="{Binding ToggleReadCommand}" ToolTip.Tip="Gelesen / ungelesen (U)" />
              <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="Klicken Sie auf weitere Mails, um sie hinzuzufügen oder zu entfernen." />
            </DockPanel>
          </Border>
        </StackPanel>

        <Grid>
          <ListBox x:Name="MessageList" Classes="messages" ItemsSource="{Binding Messages}" SelectionMode="Multiple"
                   Classes.two="{Binding QuickTwoButtons}" Classes.selecting="{Binding IsSelectionMode}"
                   IsVisible="{Binding !IsOutboxSelected}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MessageItem">
                <DockPanel>
                <!-- Quick actions like in Apple Mail: when the mail is selected, its row gets narrower and the
                     buttons slide in on the right (width animates from 0, see Window.Styles). -->
                <Border DockPanel.Dock="Right" Classes="quick" ClipToBounds="True" HorizontalAlignment="Right"
                        IsVisible="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ShowQuickActions}">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Width" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    </Transitions>
                  </Border.Transitions>
                  <Panel>
                  <!-- Alle anderen Ordner: Antworten / Verschieben / Löschen -->
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" HorizontalAlignment="Right" Width="122"
                              IsVisible="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).QuickDefault}">
                    <Button Classes="tile" ToolTip.Tip="Antworten (R)"
                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ReplyCommand}">
                      <Border Background="{DynamicResource WispAccent}">
                        <t:WispIcon Data="{StaticResource IconReply}" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Button>
                    <Button Classes="tile" ToolTip.Tip="Verschieben">
                      <Border Background="#6A6F7C">
                        <t:WispIcon Data="{StaticResource IconMove}" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                          <ScrollViewer MaxHeight="420">
                            <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveTargets}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SidebarItem">
                                  <Button Classes="icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveToCommand}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                      <t:WispIcon Data="{Binding Icon}" Foreground="{DynamicResource WispMuted}" />
                                      <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Classes="tile" ToolTip.Tip="Löschen (Entf)"
                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteCommand}">
                      <Border Background="{DynamicResource WispDanger}">
                        <t:WispIcon Data="{StaticResource IconTrash}" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Button>
                  </StackPanel>
                  <!-- Spam: Kein Spam / Löschen -->
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" HorizontalAlignment="Right" Width="80"
                              IsVisible="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).QuickJunk}">
                    <Button Classes="tile" ToolTip.Tip="Kein Spam – in den Posteingang"
                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).NotSpamCommand}">
                      <Border Background="{DynamicResource WispOk}">
                        <t:WispIcon Data="{StaticResource IconInbox}" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Button>
                    <Button Classes="tile" ToolTip.Tip="Löschen (Entf)"
                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteCommand}">
                      <Border Background="{DynamicResource WispDanger}">
                        <t:WispIcon Data="{StaticResource IconTrash}" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Button>
                  </StackPanel>

                  <!-- Entwürfe: Bearbeiten / Verwerfen -->
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" HorizontalAlignment="Right" Width="80"
                              IsVisible="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).QuickDrafts}">
                    <Button Classes="tile" ToolTip.Tip="Weiter bearbeiten"
                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).EditDraftCommand}">
                      <Border Background="{DynamicResource WispAccent}">
                        <t:WispIcon Data="{StaticResource IconCompose}" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Button>
                    <Button Classes="tile" ToolTip.Tip="Entwurf verwerfen (in den Papierkorb)"
                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteCommand}">
                      <Border Background="{DynamicResource WispDanger}">
                        <t:WispIcon Data="{StaticResource IconTrash}" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Button>
                  </StackPanel>

                  <!-- Papierkorb: Wiederherstellen / Endgültig löschen -->
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" HorizontalAlignment="Right" Width="80"
                              IsVisible="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).QuickTrash}">
                    <Button Classes="tile" ToolTip.Tip="Wiederherstellen – zurück in den ursprünglichen Ordner"
                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RestoreCommand}">
                      <Border Background="{DynamicResource WispOk}">
                        <t:WispIcon Data="{StaticResource IconReply}" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Button>
                    <Button Classes="tile" ToolTip.Tip="Endgültig löschen"
                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteCommand}">
                      <Border Background="{DynamicResource WispDanger}">
                        <t:WispIcon Data="{StaticResource IconTrash}" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Button>
                  </StackPanel>
                  </Panel>
                </Border>
                <!-- Sender initials (optional, see settings); in the inbox with a category badge in the corner -->
                <Panel DockPanel.Dock="Left" Width="34" Height="34" Margin="0,2,10,0" VerticalAlignment="Top"
                       IsVisible="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ShowAvatars}">
                  <Border CornerRadius="17" Background="{Binding AvatarBackground}">
                    <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarForeground}" FontWeight="SemiBold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border Classes="category" Background="{Binding CategoryBrush}" ToolTip.Tip="{Binding CategoryName}">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasCategory" />
                        <Binding Path="$parent[ListBox].((vm:MainViewModel)DataContext).ShowCategoryTabs" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <t:WispIcon Data="{Binding CategoryIcon}" Width="11" Height="11" Foreground="White" StrokeThickness="2.2"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Panel>
                <Grid ColumnDefinitions="12,*,Auto" RowDefinitions="Auto,Auto,Auto">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource WispAccent}" IsVisible="{Binding IsUnread}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding From}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                    <Border Classes="tag" IsVisible="{Binding IsSuspect}" ToolTip.Tip="Spamverdacht – Absender, Kopfzeilen oder Inhalt wirken verdächtig">
                      <TextBlock Text="Spam?" Classes="small" Foreground="{DynamicResource WispDanger}" FontWeight="SemiBold" />
                    </Border>
                    <t:WispIcon Data="{StaticResource IconClock}" Width="12" Height="12" IsVisible="{Binding IsPending}"
                                Foreground="{DynamicResource WispMuted}" ToolTip.Tip="Änderung wird übertragen, sobald eine Verbindung besteht" />
                    <t:WispIcon Data="{StaticResource IconAttach}" Width="12" Height="12" IsVisible="{Binding HasAttachments}"
                                Foreground="{DynamicResource WispMuted}" />
                    <t:WispIcon Data="{StaticResource IconStar}" Width="12" Height="12" IsVisible="{Binding IsFlagged}" Classes="filled on" />
                    <TextBlock Text="{Binding DateText}" Classes="muted small" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Subject}"
                             FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  <!-- Preview: the first line of text – or, in the AIEdition, the summary (marked with a spark, up to
                       two lines), so mails can be sorted out without opening them. -->
                  <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0"
                             IsVisible="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ShowPreview}">
                    <t:WispIcon DockPanel.Dock="Left" Data="{StaticResource IconSpark}" Width="11" Height="11" Margin="0,3,5,0"
                                VerticalAlignment="Top" Foreground="{DynamicResource WispAccent}" IsVisible="{Binding ShowsSummary}"
                                Classes.thinking="{Binding IsSummarizing}" ToolTip.Tip="Zusammenfassung der lokalen KI" />
                    <TextBlock Text="{Binding PreviewText}" Classes="muted small" Classes.summary="{Binding ShowsSummary}"
                               TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </Grid>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ScrollViewer IsVisible="{Binding IsOutboxSelected}">
            <ItemsControl ItemsSource="{Binding Outbox}" Margin="12,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OutboxEntry">
                  <Border Classes="card" Margin="0,0,0,8" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding To}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding State}" Classes="small" />
                      <TextBlock Text="{Binding Error}" Classes="hint" IsVisible="{Binding Error, Converter={x:Static v:Converters.NotNull}}" />
                      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <Button Classes="link" Content="Jetzt senden" IsVisible="{Binding CanRetry}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RetrySendCommand}" CommandParameter="{Binding}" />
                        <Button Classes="link" Content="Verwerfen" IsVisible="{Binding CanDiscard}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DiscardSendCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Text="Keine Mails" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding IsListEmpty}" />
        </Grid>
      </DockPanel>

      <GridSplitter Grid.Column="2" ResizeDirection="Columns" />

      <!-- ─────────── Reader ─────────── -->
      <Grid Grid.Column="3" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <DockPanel Grid.Row="0" Margin="12,10,12,6" IsVisible="{Binding HasSelection}">
          <!-- Closes the mail: deselects it and empties the reader. -->
          <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CloseMailCommand}" ToolTip.Tip="Schließen (Esc)">
            <t:WispIcon Data="{StaticResource IconClose}" />
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="icon" Command="{Binding ReplyCommand}" ToolTip.Tip="Antworten (R)"
                    IsEnabled="{Binding CurrentMail, Converter={x:Static v:Converters.NotNull}}">
              <t:WispIcon Data="{StaticResource IconReply}" />
            </Button>
            <Button Classes="icon" Command="{Binding ReplyAllCommand}" ToolTip.Tip="Allen antworten (Umschalt+R)"
                    IsEnabled="{Binding CurrentMail, Converter={x:Static v:Converters.NotNull}}">
              <t:WispIcon Data="{StaticResource IconReplyAll}" />
            </Button>
            <Button Classes="icon" Command="{Binding ForwardCommand}" ToolTip.Tip="Weiterleiten (W)"
                    IsEnabled="{Binding CurrentMail, Converter={x:Static v:Converters.NotNull}}">
              <t:WispIcon Data="{StaticResource IconForward}" />
            </Button>
            <Rectangle Width="1" Height="20" Margin="8,0" Fill="{DynamicResource WispBorder}" />
            <Button Classes="icon" Command="{Binding ArchiveCommand}" ToolTip.Tip="Archivieren (A)" IsVisible="{Binding CanArchive}">
              <t:WispIcon Data="{StaticResource IconArchive}" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="Verschieben">
              <t:WispIcon Data="{StaticResource IconMove}" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ScrollViewer MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding MoveTargets}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SidebarItem">
                          <Button Classes="icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveToCommand}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <t:WispIcon Data="{Binding Icon}" Foreground="{DynamicResource WispMuted}" />
                              <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Classes="icon" Command="{Binding DeleteCommand}" ToolTip.Tip="Löschen (Entf)">
              <t:WispIcon Data="{StaticResource IconTrash}" />
            </Button>
            <Rectangle Width="1" Height="20" Margin="8,0" Fill="{DynamicResource WispBorder}" />
            <Button Classes="icon" Command="{Binding ToggleReadCommand}" ToolTip.Tip="Gelesen / ungelesen (U)">
              <t:WispIcon Data="{StaticResource IconMail}" Classes.on="{Binding CurrentIsUnread}" />
            </Button>
            <Button Classes="icon" Command="{Binding ToggleFlagCommand}" ToolTip.Tip="Markieren (S)">
              <t:WispIcon Data="{StaticResource IconStar}" Classes="filled" Classes.on="{Binding CurrentIsFlagged}" />
            </Button>
          </StackPanel>
        </DockPanel>

        <!-- Header: subject, then the sender's initials, name and recipients, date on the right. Filled from the list
             row at once (CurrentItem), so it never shows the previous mail while this one loads.
             Double-clicking an address selects all of it (see MainWindow.axaml.cs). -->
        <StackPanel x:Name="ReaderHeader" Grid.Row="1" Margin="24,2,24,12" Spacing="12"
                    IsVisible="{Binding CurrentItem, Converter={x:Static v:Converters.NotNull}}">
          <SelectableTextBlock Text="{Binding CurrentItem.Subject, FallbackValue=''}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="avatar" Background="{Binding CurrentItem.AvatarBackground, FallbackValue={x:Null}}" VerticalAlignment="Top">
              <TextBlock Text="{Binding CurrentItem.Initials, FallbackValue=''}" Foreground="{Binding CurrentItem.AvatarForeground, FallbackValue={x:Null}}"
                         FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
              <SelectableTextBlock x:Name="FromText" Text="{Binding HeaderFrom}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <SelectableTextBlock x:Name="RecipientsText" Text="{Binding Recipients}" Classes="muted small" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="2" Classes="muted small" VerticalAlignment="Top" Margin="12,2,0,0"
                       Text="{Binding CurrentItem.LongDateText, FallbackValue=''}" ToolTip.Tip="{Binding CurrentItem.FullDateText, FallbackValue=''}" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="24,0,24,10" Spacing="8">
          <!-- Wisp 2 (AIEdition): summary by the local model. The spark breathes while it is being written. -->
          <Border x:Name="SummaryCard" Classes="summary" IsVisible="{Binding ShowSummary}">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <t:WispIcon Data="{StaticResource IconSpark}" Width="13" Height="13" Foreground="{DynamicResource WispAccent}"
                            Classes.thinking="{Binding IsSummarizing}" />
                <TextBlock Text="Zusammenfassung" Classes="small" FontWeight="SemiBold" Foreground="{DynamicResource WispAccent}" />
                <TextBlock Text="· lokal erstellt, kann Fehler enthalten" Classes="muted small" />
              </StackPanel>
              <SelectableTextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                   IsVisible="{Binding Summary, Converter={x:Static v:Converters.NotNull}}" />
              <TextBlock Text="{Binding SummaryWaitText}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding SummaryWaitText, Converter={x:Static v:Converters.NotNull}}" />
            </StackPanel>
          </Border>
          <Button Classes="chip ai" HorizontalAlignment="Left" IsVisible="{Binding CanSummarize}" Command="{Binding SummarizeCommand}"
                  ToolTip.Tip="Das lokale KI-Modell fasst diese Mail zusammen. Nichts verlässt Ihren Computer.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <t:WispIcon Data="{StaticResource IconSpark}" Width="13" Height="13" />
              <TextBlock Text="Zusammenfassen" VerticalAlignment="Center" />
              <Border Classes="kbd" Margin="2,0,0,0"><TextBlock Text="Z" /></Border>
            </StackPanel>
          </Button>
          <Border Classes="notice" IsVisible="{Binding ShowRemoteImageBanner}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Bilder laden" Command="{Binding LoadImagesCommand}" />
              <TextBlock Text="Externe Bilder wurden blockiert, damit der Absender nicht sieht, dass Sie die Mail geöffnet haben."
                         TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
          </Border>
          <Border Classes="notice" IsVisible="{Binding ShowHtmlBanner}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Originaldarstellung" Command="{Binding ShowOriginalCommand}" />
              <TextBlock Text="Diese Mail wird als einfacher Text angezeigt." TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Attachments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AttachmentItem">
                <Button Classes="chip" Margin="0,0,6,6" ToolTip.Tip="Speichern unter …"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveAttachmentCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <t:WispIcon Data="{StaticResource IconAttach}" Width="13" Height="13" />
                    <TextBlock Text="{Binding Name}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SizeText}" Classes="muted small" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{DynamicResource WispBorder}"
                BorderThickness="{Binding CurrentItem, Converter={x:Static v:Converters.TopLineIfSet}}">
          <Grid>
            <!-- Hidden at once when another mail is chosen, faded in when its content is there (MainWindow.axaml.cs). -->
            <ContentControl x:Name="ReaderBody" />
            <!-- Nothing open: where things stand and the next step, instead of an empty "Keine Mail ausgewählt". -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="340"
                        IsVisible="{Binding ShowReaderIdle}">
              <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource WispField}" HorizontalAlignment="Center" Margin="0,0,0,6">
                <Panel>
                  <t:WispIcon Data="{StaticResource IconCheck}" Width="24" Height="24" Foreground="{DynamicResource WispOk}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ReaderIdleAllRead}" />
                  <t:WispIcon Data="{StaticResource IconMail}" Width="24" Height="24" Foreground="{DynamicResource WispMuted}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !ReaderIdleAllRead}" />
                </Panel>
              </Border>
              <TextBlock Text="{Binding ReaderIdleTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding ReaderIdleHint}" Classes="muted small" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Wird geladen …" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding ShowLoading}" />
            <TextBlock Text="{Binding ReaderProblem}" Classes="muted" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding ReaderProblem, Converter={x:Static v:Converters.NotNull}}" />
          </Grid>
        </Border>

        <!-- Quick reply: most answers are short, they should not need a window of their own.
             Enter (in the list) jumps here, Strg+Enter sends, Esc goes back to the list and keeps the text. -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="20,8,20,14" IsVisible="{Binding CanQuickReply}">
          <TextBox x:Name="QuickReplyBox" Classes="soft" Text="{Binding QuickReplyText}" PlaceholderText="{Binding QuickReplyPlaceholder}"
                   AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200" VerticalContentAlignment="Top">
            <TextBox.InnerRightContent>
              <Button Classes="icon" Padding="6" Margin="0,0,4,0" VerticalAlignment="Top" Command="{Binding ExpandQuickReplyCommand}"
                      ToolTip.Tip="Im großen Fenster weiterschreiben (Cc, Anhänge, Formatierung)">
                <t:WispIcon Data="{StaticResource IconExpand}" Width="13" Height="13" Foreground="{DynamicResource WispMuted}" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
          <!-- Right-click (or holding) the send button: capsules slide up out of it – "Speichern" and "Später senden",
               which turns into the times. The capsules float above the mail (Canvas: they take no room). -->
          <Panel x:Name="QuickSendHost" Grid.Column="1" Margin="8,0,0,3" VerticalAlignment="Bottom" Background="Transparent">
            <Button x:Name="QuickSendButton" Classes="send" Command="{Binding SendQuickReplyCommand}"
                    ToolTip.Tip="Senden (Strg+Enter) · Rechtsklick: speichern oder später senden">
              <t:WispIcon Data="{StaticResource IconArrowUp}" Width="16" Height="16" StrokeThickness="2.2" />
            </Button>
            <Canvas>
              <StackPanel x:Name="SendMenu" Canvas.Right="0" Canvas.Bottom="42" Spacing="8" IsVisible="False">
                <Border Classes="capsulehost"><Button Classes="capsule" Command="{Binding SaveQuickReplyCommand}"
                        ToolTip.Tip="Im Ordner „Entwürfe“ ablegen und später weiterschreiben – auch auf anderen Geräten">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <t:WispIcon Data="{StaticResource IconDraft}" Width="15" Height="15" />
                    <TextBlock Text="Speichern" />
                  </StackPanel>
                </Button></Border>
                <Border Classes="capsulehost"><Button Classes="capsule" Command="{Binding ShowSendLaterCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <t:WispIcon Data="{StaticResource IconClock}" Width="15" Height="15" />
                    <TextBlock Text="Später senden" />
                  </StackPanel>
                </Button></Border>
              </StackPanel>
              <ItemsControl x:Name="SendTimesMenu" Canvas.Right="0" Canvas.Bottom="42" IsVisible="False" ItemsSource="{Binding SendTimes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SendTime">
                    <Border Classes="capsulehost"><Button Classes="capsule" CommandParameter="{Binding}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SendQuickReplyAtCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <t:WispIcon Data="{StaticResource IconClock}" Width="15" Height="15" />
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" />
                      </StackPanel>
                    </Button></Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Canvas>
          </Panel>
        </Grid>
      </Grid>

      <!-- ─────────── Sidebar (last child: lies on top of the list when expanded) ─────────── -->
      <Border x:Name="Sidebar" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" ClipToBounds="True"
              Classes.open="{Binding SidebarAlwaysOpen}"
              Background="{DynamicResource WispSidebar}" BorderBrush="{DynamicResource WispBorder}" BorderThickness="0,0,1,0">
        <Border.DataTemplates>
          <!-- One row layout for pinned and normal items; identical in both states. -->
          <DataTemplate DataType="vm:SidebarItem" x:DataType="vm:SidebarItem">
              <!-- Folder: icon (special folders) or coloured initial (own folders) -->
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Border Width="{Binding IndentWidth}" />
                <Panel Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                  <t:WispIcon Data="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="18" Height="18"
                              Foreground="{DynamicResource WispMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border IsVisible="{Binding !HasIcon}" Width="22" Height="22" CornerRadius="6"
                          Background="{Binding BadgeBackground}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Initial}" Foreground="{Binding BadgeForeground}" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Panel Classes="narrow">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource WispAccent}" Stroke="{DynamicResource WispSidebar}" StrokeThickness="1.5"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" IsVisible="{Binding HasUnread}" />
                  </Panel>
                </Panel>
                <TextBlock Grid.Column="2" Classes="wide" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="3" Classes="wide" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0,0,0">
                  <TextBlock Text="!" Foreground="{DynamicResource WispDanger}" FontWeight="Bold"
                             IsVisible="{Binding Status, Converter={x:Static v:Converters.NotNull}}" />
                  <TextBlock Text="{Binding Unread}" IsVisible="{Binding HasUnread}" Classes="small"
                             Foreground="{DynamicResource WispAccent}" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
          </DataTemplate>
        </Border.DataTemplates>

        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="12,16,12,8" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="9,0,0,0">
              <Image Source="/Assets/wisp.png" Width="22" Height="22" />
              <TextBlock Classes="wide" Text="Wisp" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Account switcher: the sidebar shows one account at a time. Collapsed: the account's coloured initial,
                 with a dot when another account has new mail. -->
            <Button x:Name="AccountSwitcher" Classes="icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Padding="7,6" IsVisible="{Binding HasAccounts}" ToolTip.Tip="Konto wechseln">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Panel Width="26" Height="26">
                  <Border CornerRadius="13" Background="{Binding ActiveAccount.BadgeBackground, FallbackValue={x:Null}}">
                    <TextBlock Text="{Binding ActiveAccount.Initial, FallbackValue=''}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Ellipse Width="9" Height="9" Fill="{DynamicResource WispAccent}" Stroke="{DynamicResource WispSidebar}" StrokeThickness="1.5"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" IsVisible="{Binding OtherAccountsUnread}" />
                </Panel>
                <TextBlock Grid.Column="1" Classes="wide" Text="{Binding ActiveAccount.Email, FallbackValue=''}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,6,0" />
                <t:WispIcon Grid.Column="2" Classes="wide" Data="{StaticResource IconSwitch}" Width="16" Height="16"
                            Foreground="{DynamicResource WispMuted}" VerticalAlignment="Center" />
              </Grid>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel x:Name="AccountMenu" MinWidth="260" MaxWidth="380" Spacing="2">
                    <TextBlock Classes="header" Text="Konten" Margin="8,0,8,4" />
                    <ItemsControl ItemsSource="{Binding Accounts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountItem">
                          <Button Classes="icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SwitchAccountCommand}" CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto,24">
                              <Border Width="24" Height="24" CornerRadius="12" Background="{Binding BadgeBackground}">
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Grid.Column="1" Text="{Binding Email}" Margin="10,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="!" Foreground="{DynamicResource WispDanger}" FontWeight="Bold" IsVisible="{Binding HasProblem}"
                                           ToolTip.Tip="Verbindungsproblem" />
                                <TextBlock Text="{Binding Unread}" IsVisible="{Binding HasUnread}" Classes="small"
                                           Foreground="{DynamicResource WispAccent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                              </StackPanel>
                              <t:WispIcon Grid.Column="3" Data="{StaticResource IconCheck}" Width="16" Height="16" HorizontalAlignment="Right"
                                          Foreground="{DynamicResource WispAccent}" IsVisible="{Binding IsActive}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Margin="4,4" Background="{DynamicResource WispBorder}" />
                    <Button Classes="icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                            Command="{Binding AddAccountCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Panel Width="24">
                          <t:WispIcon Data="{StaticResource IconPlus}" Foreground="{DynamicResource WispMuted}" HorizontalAlignment="Center" />
                        </Panel>
                        <TextBlock Text="Konto hinzufügen" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>

            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="11,8"
                    Command="{Binding ComposeCommand}" IsEnabled="{Binding HasAccounts}" ToolTip.Tip="Neue Mail (N)">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <t:WispIcon Data="{StaticResource IconCompose}" />
                <TextBlock Classes="wide" Text="Neue Mail" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Pinned: the inbox(es) always stay at the top and do not scroll away -->
          <ListBox x:Name="PinnedList" DockPanel.Dock="Top" Classes="sidebar" ItemsSource="{Binding Pinned}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
          <Border DockPanel.Dock="Top" Height="1" Margin="14,6" Background="{DynamicResource WispBorder}" />

          <!-- Bottom bar: same layout in both states; settings and status dot sit in the always visible strip. -->
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource WispBorder}" BorderThickness="0,1,0,0" Padding="8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
              <Button Classes="icon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Einstellungen (Strg+,) · Tastenkürzel: F1">
                <t:WispIcon Data="{StaticResource IconSettings}" />
              </Button>
              <Ellipse Grid.Column="1" Width="8" Height="8" Margin="2,0,8,0" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusText}"
                       Fill="{Binding StatusKind, Converter={x:Static v:Converters.StatusBrush}}" />
              <TextBlock Grid.Column="2" Classes="wide muted small" Text="{Binding StatusText}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
              <Button Grid.Column="3" Classes="icon wide" Command="{Binding RefreshCommand}" ToolTip.Tip="Aktualisieren (F5)">
                <t:WispIcon Data="{StaticResource IconRefresh}" />
              </Button>
              <Button Grid.Column="4" Classes="icon wide" Command="{Binding AddAccountCommand}" ToolTip.Tip="Konto hinzufügen">
                <t:WispIcon Data="{StaticResource IconPlus}" />
              </Button>
            </Grid>
          </Border>

          <ListBox x:Name="FolderList" Classes="sidebar" ItemsSource="{Binding Sidebar}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- Welcome screen without accounts -->
    <Border Background="{DynamicResource WispWindow}" IsVisible="{Binding !HasAccounts}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="420">
        <Image Source="/Assets/wisp.png" Width="72" Height="72" />
        <TextBlock Text="Willkommen bei Wisp" Classes="title" HorizontalAlignment="Center" />
        <TextBlock Text="Ein leichter, sicherer Mail-Client. Ihre Mails und Passwörter werden verschlüsselt auf diesem Gerät gespeichert."
                   Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
        <Button Classes="primary" HorizontalAlignment="Center" Content="Konto hinzufügen" Command="{Binding AddAccountCommand}" />
      </StackPanel>
    </Border>

    <!-- Toast: a small pill that glides up from the bottom and fades away again. Shown, filled and hidden by
         MainWindow.axaml.cs, so the text stays readable while it fades out. Stays while the mouse is on it. -->
    <Border x:Name="Toast" Classes="toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,24"
            MaxWidth="560" IsVisible="False">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="icon" Padding="7" Margin="2,0,0,0" VerticalAlignment="Center"
                Command="{Binding DismissNoticeCommand}" ToolTip.Tip="Schließen">
          <t:WispIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
        </Button>
        <Button x:Name="ToastAction" DockPanel.Dock="Right" Classes="link" Margin="10,0,0,0" VerticalAlignment="Center"
                Foreground="{DynamicResource WispToastText}" FontWeight="SemiBold" Command="{Binding NoticeActionCommand}" />
        <TextBlock x:Name="ToastText" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Command field (Strg+K): folders, tabs, accounts, actions on the open mail, search – one field. -->
    <Panel x:Name="PaletteLayer" IsVisible="False">
      <Border x:Name="PaletteBackdrop" Background="{DynamicResource WispBackdrop}" />
      <Border x:Name="PaletteCard" Classes="palette" Width="560" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,72,16,16">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="18,10,18,10">
            <t:WispIcon DockPanel.Dock="Left" Data="{StaticResource IconSearch}" Width="18" Height="18" Margin="0,0,12,0"
                        Foreground="{DynamicResource WispMuted}" VerticalAlignment="Center" />
            <TextBox x:Name="PaletteBox" Classes="bare" FontSize="16" Text="{Binding PaletteQuery}" PlaceholderText="{Binding PaletteHint}" />
          </DockPanel>
          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource WispBorder}" />
          <TextBlock DockPanel.Dock="Bottom" Classes="muted small" Margin="18,4,18,10"
                     Text="↑ ↓ wählen  ·  Enter ausführen  ·  Esc schließen" />
          <ListBox x:Name="PaletteList" Classes="palette" ItemsSource="{Binding PaletteResults}" SelectedItem="{Binding SelectedPaletteEntry}"
                   Margin="0,6,0,4" MaxHeight="420" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteEntry">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <t:WispIcon Data="{Binding Icon}" Width="16" Height="16" Foreground="{DynamicResource WispMuted}" VerticalAlignment="Center" />
                  <DockPanel Grid.Column="1" Margin="12,0,10,0">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Classes="muted small" Margin="10,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDetail}" />
                  </DockPanel>
                  <Border Grid.Column="2" Classes="kbd" IsVisible="{Binding HasKeys}">
                    <TextBlock Text="{Binding Keys}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Panel>
  </Grid>
</Window>
