<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wisp.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WispWindow" Color="#FBFAFD" />
          <SolidColorBrush x:Key="WispSidebar" Color="#F3F1F8" />
          <SolidColorBrush x:Key="WispSurface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="WispBorder" Color="#E5E2EC" />
          <SolidColorBrush x:Key="WispText" Color="#1C1A24" />
          <SolidColorBrush x:Key="WispMuted" Color="#6B6878" />
          <SolidColorBrush x:Key="WispHover" Color="#0D000000" />
          <SolidColorBrush x:Key="WispNoticeBg" Color="#FFF5E1" />
          <SolidColorBrush x:Key="WispNotice" Color="#8A5200" />
          <SolidColorBrush x:Key="WispDanger" Color="#C62F3B" />
          <SolidColorBrush x:Key="WispOk" Color="#2E9D57" />
          <!-- Wisp 2 UI: quiet input fields, floating toast (inverted), dimmed backdrop of the command field -->
          <SolidColorBrush x:Key="WispField" Color="#EFEDF4" />
          <SolidColorBrush x:Key="WispToastBg" Color="#25232E" />
          <SolidColorBrush x:Key="WispToastText" Color="#F5F4F9" />
          <SolidColorBrush x:Key="WispToastMuted" Color="#A9A6B8" />
          <SolidColorBrush x:Key="WispBackdrop" Color="#1F000000" />
          <BoxShadows x:Key="WispFloatShadow">0 8 28 0 #26000000, 0 1 3 0 #14000000</BoxShadows>
          <!-- Fluent menus (submenus, drop-down menus) on the same card as the right-click menu -->
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#E5E2EC" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#E5E2EC" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WispWindow" Color="#15141A" />
          <SolidColorBrush x:Key="WispSidebar" Color="#1C1B23" />
          <SolidColorBrush x:Key="WispSurface" Color="#1A1920" />
          <SolidColorBrush x:Key="WispBorder" Color="#2D2B37" />
          <SolidColorBrush x:Key="WispText" Color="#E9E7F0" />
          <SolidColorBrush x:Key="WispMuted" Color="#9895A8" />
          <SolidColorBrush x:Key="WispHover" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="WispNoticeBg" Color="#3A2E17" />
          <SolidColorBrush x:Key="WispNotice" Color="#F2C27A" />
          <SolidColorBrush x:Key="WispDanger" Color="#F06B74" />
          <SolidColorBrush x:Key="WispOk" Color="#5CC587" />
          <SolidColorBrush x:Key="WispField" Color="#24222D" />
          <SolidColorBrush x:Key="WispToastBg" Color="#EEEDF3" />
          <SolidColorBrush x:Key="WispToastText" Color="#15141A" />
          <SolidColorBrush x:Key="WispToastMuted" Color="#625F70" />
          <SolidColorBrush x:Key="WispBackdrop" Color="#59000000" />
          <BoxShadows x:Key="WispFloatShadow">0 10 32 0 #66000000, 0 1 3 0 #33000000</BoxShadows>
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#1A1920" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2D2B37" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#1A1920" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#2D2B37" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Overwritten at runtime by ThemeManager from the user's settings. The accent brushes (WispAccent,
           WispAccentSoft, WispOnAccent) are put into the two theme dictionaries above by ThemeManager. -->
      <FontFamily x:Key="WispFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
      <x:Double x:Key="WispFontSize">14</x:Double>
      <x:Double x:Key="WispSmallFontSize">12</x:Double>
      <x:Double x:Key="WispTitleFontSize">20</x:Double>
      <Thickness x:Key="WispRowPadding">12,8</Thickness>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Theme/WispStyles.axaml" />
  </Application.Styles>
</Application>
